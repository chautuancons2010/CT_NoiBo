{
  "name": "chau-tuan-internal-system",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống nội bộ Châu Tuấn - enterprise internal web foundation.",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "build:wasm": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:authenticated": "node scripts/authenticated-smoke.mjs",
    "audit:data-health": "node scripts/data-health-audit.mjs",
    "ui:audit": "node scripts/ui-route-audit.mjs",
    "ui:architecture-audit": "node scripts/ui-architecture-audit.mjs",
    "ui:screen-audit": "node scripts/ui-screen-audit.mjs",
    "ui:qa": "node scripts/ui-qa.mjs",
    "ui:core-qa": "node scripts/ui-core-responsive-qa.mjs",
    "ui:release-qa": "node scripts/ui-release-qa.mjs",
    "ui:interaction-qa": "node scripts/ui-interaction-qa.mjs",
    "ui:reference-qa": "node scripts/ui-reference-qa.mjs",
    "ui:performance-qa": "node scripts/ui-performance-qa.mjs",
    "ui:golden-qa": "node scripts/golden-visual-qa.mjs",
    "migration:dry-run": "node scripts/migration/dry-run.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "seed:storage": "node scripts/seed-development-storage.mjs",
    "seed:storage:reset": "node scripts/seed-development-storage.mjs --reset",
    "seed:coverage": "node scripts/seed-development-coverage.mjs",
    "seed:coverage:reset": "node scripts/seed-development-coverage.mjs --reset",
    "seed:employees": "node scripts/seed-development-employees.mjs",
    "seed:employees:reset": "node scripts/seed-development-employees.mjs --reset",
    "seed:dev": "supabase db reset && node scripts/seed-development-coverage.mjs && node scripts/seed-development-storage.mjs",
    "seed:reset": "supabase db reset --no-seed"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.45.4",
    "docxtemplater": "^3.71.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rolldown/binding-wasm32-wasi": "^1.2.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.63.0",
    "supabase": "^2.117.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
